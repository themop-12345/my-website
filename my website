    /* ─── What I Do ────────────────────────────────────────────────── */
    #services { background: var(--navy-mid); }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }
    .service-card {
      background: var(--navy-card);
