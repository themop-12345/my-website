  <button class="chat-bubble" id="chatBubble" aria-label="Open chat">
    <div class="chat-notification" id="chatNotif">1</div>
    <svg class="icon-chat" viewBox="0 0 24 24"><path d="M20 2H4a2 2 0 00-2 2v18l4-4h14a2 2 0 002-2V4a2 2 0 00-2-2zm-2 10H6V10h12v2zm0-3H6V7h12v2z"/></svg>
    <svg class="icon-close" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" stroke="white" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
  </button>

  <div class="chat-window" id="chatWindow" role="dialog" aria-label="Chat with Craft">
    <div class="chat-header">
      <div class="chat-avatar">🤖</div>
      <div>
        <div class="chat-header-name">Craft — SiteCraft Assistant</div>
        <div class="chat-header-status">Online now</div>
      </div>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div class="chat-options" id="chatOptions"></div>
    <div class="chat-input-row">
      <input class="chat-input" id="chatInput" type="text" placeholder="Type a message…" autocomplete="off" />
      <button class="chat-send" id="chatSendBtn" aria-label="Send">
        <svg viewBox="0 0 24 24"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
      </button>
    </div>
  </div>

  <script>
    // ── Navbar scroll ──────────────────────────────────────────────
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });

    // ── Mobile hamburger ───────────────────────────────────────────
    const hamburger = document.getElementById('hamburger');
    const navLinks  = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('open');
      navLinks.classList.toggle('open');
    });
    hamburger.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') hamburger.click();
    });
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('open');
        navLinks.classList.remove('open');
      });
    });

    // ── Scroll reveal ──────────────────────────────────────────────
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    revealEls.forEach(el => observer.observe(el));

    // Hero elements visible immediately
    document.querySelectorAll('#hero .reveal').forEach(el => {
      el.classList.add('visible');
    });

    // ── Contact form (Netlify Forms) ────────────────────────────────
    function handleSubmit(e) {
      e.preventDefault();
      const form    = document.getElementById('contactForm');
      const data    = new FormData(form);

      fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data).toString() })
        .then(() => {
          form.style.display = 'none';
          document.getElementById('formSuccess').style.display = 'block';
        })
        .catch(() => {
          alert('Something went wrong. Please try WhatsApp or try again.');
        });
    }

    // ── Before & After slider ─────────────────────────────────────
    (function() {
      const wrapper = document.getElementById('baWrapper');
      const after   = document.getElementById('baAfter');
      const handle  = document.getElementById('baHandle');
      if (!wrapper) return;

      let dragging = false;

      function setPos(x) {
        const rect = wrapper.getBoundingClientRect();
        let pct = (x - rect.left) / rect.width;
        pct = Math.max(0.08, Math.min(0.92, pct));
        const pctStr = (pct * 100).toFixed(2) + '%';
        after.style.width  = pctStr;
        handle.style.left  = pctStr;
      }

      handle.addEventListener('mousedown',  () => dragging = true);
      wrapper.addEventListener('mousemove', e => { if (dragging) setPos(e.clientX); });
      window.addEventListener('mouseup',    () => dragging = false);

      handle.addEventListener('touchstart', e => { dragging = true; e.preventDefault(); }, { passive: false });
      wrapper.addEventListener('touchmove', e => { if (dragging) setPos(e.touches[0].clientX); e.preventDefault(); }, { passive: false });
      window.addEventListener('touchend',   () => dragging = false);

      wrapper.addEventListener('click', e => setPos(e.clientX));
    })();

    // ── Chatbot ────────────────────────────────────────────────────
    (function() {
      const bubble   = document.getElementById('chatBubble');
      const win      = document.getElementById('chatWindow');
      const msgs     = document.getElementById('chatMessages');
      const options  = document.getElementById('chatOptions');
      const input    = document.getElementById('chatInput');
      const sendBtn  = document.getElementById('chatSendBtn');
      const notif    = document.getElementById('chatNotif');
      let   started  = false;

      // Decision tree
      const tree = {
        start: {
          bot: "Hi there! 👋 I'm Craft, SiteCraft's assistant. What can I help you with today?",
          options: [
            { label: "💻 I need a new website",         next: 'newSite' },
            { label: "🔧 My website needs updating",    next: 'reno' },
            { label: "💷 How much does it cost?",       next: 'pricing' },
            { label: "⏱️ How long does it take?",       next: 'turnaround' },
          ]
        },
        newSite: {
          bot: "Great choice! A brand new website starts from just £200 — one flat payment, nothing hidden. Do you currently have any online presence?",
          options: [
            { label: "No, starting from scratch",  next: 'newScratch' },
            { label: "I only have social media",   next: 'newSocial' },
          ]
        },
        newScratch: {
          bot: "Perfect — that's exactly what SiteCraft is here for. I'll build you a clean, fast, mobile-friendly site in 7–10 days. Want to get a free no-obligation quote?",
          options: [
            { label: "✅ Yes, get a free quote", next: 'goQuote' },
            { label: "📋 What's included?",      next: 'included' },
          ]
        },
        newSocial: {
          bot: "Social media is great, but a proper website builds far more trust with customers. I'll make sure it links up perfectly with your socials too. Ready for a free quote?",
          options: [
            { label: "✅ Yes, get a free quote", next: 'goQuote' },
            { label: "📋 What's included?",      next: 'included' },
          ]
        },
        reno: {
          bot: "No problem — website renovations also start at £200. How would you describe your current site?",
          options: [
            { label: "It looks really outdated",       next: 'renoOld' },
            { label: "It's broken or not working",     next: 'renoBroken' },
            { label: "It's just not getting results",  next: 'renoResults' },
          ]
        },
        renoOld: {
          bot: "That's the most common one! An outdated site can actually put customers off. I'll give it a full modern redesign while keeping your content and domain. Want a free quote?",
          options: [
            { label: "✅ Yes, free quote please", next: 'goQuote' },
            { label: "📋 What's included?",       next: 'included' },
          ]
        },
        renoBroken: {
          bot: "A broken website is losing you customers every day — let's fix that fast. I'll rebuild it properly so everything works perfectly. Want me to take a look?",
          options: [
            { label: "✅ Yes, get in touch",  next: 'goQuote' },
            { label: "💷 How much?",          next: 'pricing' },
          ]
        },
        renoResults: {
          bot: "A website that doesn't convert visitors is just a cost. I'll redesign it with a focus on getting customers to actually contact you. Want a free quote?",
          options: [
            { label: "✅ Yes, free quote please", next: 'goQuote' },
            { label: "📋 What's included?",       next: 'included' },
          ]
        },
        pricing: {
          bot: "Really straightforward pricing here:\n\n💻 New Website — £200 one-off\n🔧 Website Renovation — £200 one-off\n🛡️ Monthly Maintenance — £20/month\n\nNo hidden fees, no ongoing platform costs.",
          options: [
            { label: "✅ Get a free quote",          next: 'goQuote' },
            { label: "📋 What's included?",          next: 'included' },
            { label: "⏱️ How long does it take?",   next: 'turnaround' },
          ]
        },
        turnaround: {
          bot: "Most websites are built and live within 7–10 working days from when you send your details over. If you need it faster, just mention it — I'll do my best.",
          options: [
            { label: "✅ Get a free quote",     next: 'goQuote' },
            { label: "💷 How much does it cost?", next: 'pricing' },
          ]
        },
        included: {
          bot: "Every website includes:\n✔ Custom design\n✔ Mobile-friendly on all devices\n✔ Contact form\n✔ Basic SEO setup\n✔ Fast & secure (HTTPS)\n✔ Deployed to your domain\n\nRenovations also include migrating all your existing content.",
          options: [
            { label: "✅ Sounds good — free quote", next: 'goQuote' },
            { label: "💷 Remind me of the price",   next: 'pricing' },
          ]
        },
        goQuote: {
          bot: "Brilliant! The quickest way is to either fill in the contact form on this page, or message directly on WhatsApp. I'll get back to you within a few hours. 🙌",
          options: [
            { label: "📝 Go to the contact form",  next: 'doForm' },
            { label: "💬 Open WhatsApp",           next: 'doWhatsApp' },
          ]
        },
        doForm:     { bot: null, action: 'form' },
        doWhatsApp: { bot: null, action: 'whatsapp' },
      };

      function scrollBottom() {
        msgs.scrollTop = msgs.scrollHeight;
      }

      function addMsg(text, who) {
        const wrap = document.createElement('div');
        wrap.className = 'chat-msg ' + who;
        const av = document.createElement('div');
        av.className = 'chat-msg-avatar';
        av.textContent = who === 'bot' ? '🤖' : '👤';
        const bub = document.createElement('div');
        bub.className = 'chat-msg-bubble';
        bub.style.whiteSpace = 'pre-line';
        bub.textContent = text;
        wrap.appendChild(av);
        wrap.appendChild(bub);
        msgs.appendChild(wrap);
        scrollBottom();
      }

      function showTyping() {
        const wrap = document.createElement('div');
        wrap.className = 'chat-typing';
        wrap.id = 'typingIndicator';
        wrap.innerHTML = '<div class="chat-typing-avatar">🤖</div><div class="chat-typing-bubble"><span></span><span></span><span></span></div>';
        msgs.appendChild(wrap);
        scrollBottom();
        return wrap;
      }

      function clearOptions() {
        options.innerHTML = '';
        input.value = '';
      }

      function showOptions(opts) {
        clearOptions();
        opts.forEach(opt => {
          const btn = document.createElement('button');
          btn.className = 'chat-option';
          btn.textContent = opt.label;
          btn.addEventListener('click', () => handleOption(opt));
          options.appendChild(btn);
        });
      }

      function handleOption(opt) {
        addMsg(opt.label, 'user');
        clearOptions();
        goToNode(opt.next);
      }

      function goToNode(key) {
        const node = tree[key];
        if (!node) return;

        // Actions
        if (node.action === 'form') {
          setTimeout(() => {
            win.classList.remove('open');
            bubble.classList.remove('open');
            const target = document.querySelector('#contact');
            if (target) {
              const offset = document.getElementById('navbar').offsetHeight + 16;
              window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' });
            }
          }, 300);
          return;
        }
        if (node.action === 'whatsapp') {
          setTimeout(() => {
            window.open('https://wa.me/447535056319?text=Hi%2C%20I%27d%20like%20a%20free%20quote%20for%20a%20website', '_blank');
          }, 300);
          return;
        }

        const typing = showTyping();
        setTimeout(() => {
          typing.remove();
          if (node.bot) addMsg(node.bot, 'bot');
          if (node.options && node.options.length) showOptions(node.options);
        }, 900 + Math.random() * 400);
      }

      function handleUserText() {
        const text = input.value.trim();
        if (!text) return;
        addMsg(text, 'user');
        input.value = '';
        clearOptions();

        // Simple keyword matching for free-text input
        const t = text.toLowerCase();
        if (t.match(/price|cost|how much|£/))         goToNode('pricing');
        else if (t.match(/how long|time|days|fast/))  goToNode('turnaround');
        else if (t.match(/include|what.*get|feature/))goToNode('included');
        else if (t.match(/new|build|start/))          goToNode('newSite');
        else if (t.match(/old|broken|fix|redo|renov/))goToNode('reno');
        else if (t.match(/quote|contact|talk|whatsapp|call/)) goToNode('goQuote');
        else {
          const typing = showTyping();
          setTimeout(() => {
            typing.remove();
            addMsg("I'm not sure about that one! Here are some things I can help with:", 'bot');
            showOptions(tree.start.options);
          }, 800);
        }
      }

      // Toggle open/close
      bubble.addEventListener('click', () => {
        const isOpen = win.classList.toggle('open');
        bubble.classList.toggle('open', isOpen);
        notif.style.display = 'none';
        if (isOpen && !started) {
          started = true;
          goToNode('start');
        }
      });

      // Send on enter / button
      input.addEventListener('keydown', e => { if (e.key === 'Enter') handleUserText(); });
      sendBtn.addEventListener('click', handleUserText);

      // Show notification after 4s to entice a click
      setTimeout(() => { notif.style.display = 'flex'; }, 4000);
    })();

    // ── Smooth anchor offset (account for fixed nav) ───────────────
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (!target) return;
        e.preventDefault();
        const offset = navbar.offsetHeight + 16;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      });
    });
  </script>
</body>
</html>
