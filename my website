  <style>
    /* ─── Reset & Base ─────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:        #0b1120;
      --navy-mid:    #111827;
      --navy-light:  #1a2540;
      --navy-card:   #162035;
      --white:       #ffffff;
      --off-white:   #e8edf5;
      --blue:        #0ea5e9;
      --blue-bright: #38bdf8;
      --blue-glow:   rgba(14, 165, 233, 0.18);
      --blue-border: rgba(14, 165, 233, 0.35);
      --text-muted:  #94a3b8;
      --text-body:   #cbd5e1;
      --radius:      12px;
      --radius-lg:   20px;
      --shadow:      0 4px 24px rgba(0,0,0,0.35);
      --shadow-glow: 0 0 40px rgba(14, 165, 233, 0.15);
