      .nav-links.open { display: flex; }
      .nav-links li { width: 100%; }
      .nav-links a {
        display: block;
        padding: 13px 28px;
        font-size: 1rem;
      }
      .nav-cta {
        margin: 8px 28px 0;
        text-align: center;
        border-radius: 8px;
      }
    }

    /* ─── Hero ─────────────────────────────────────────────────────── */
